# Supabase (apenas chaves públicas no frontend — NUNCA a service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# URL pública da loja (canonical / Open Graph / sitemap)
VITE_SITE_URL=http://localhost:5190
# Mercado Pago — chave PÚBLICA (Card Payment Brick). O access token fica só nas Edge Functions.
VITE_MP_PUBLIC_KEY=

# ---- Secrets das Edge Functions (supabase secrets set ...) — NÃO usar no frontend ----
# MP_ACCESS_TOKEN=TEST-...
# MP_WEBHOOK_SECRET=...
# SITE_URL=https://sua-loja.com.br
